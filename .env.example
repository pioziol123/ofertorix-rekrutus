# Generate .env with: node scripts/setup-env.mjs
POSTGRES_PASSWORD=replace-with-a-local-random-secret
WEB_PORT=3100

# Daily SOLID.Jobs import, Europe/Warsaw
SOURCE_SYNC_TIME=08:00


# Optional, server-only. Leave blank until pricing and controlled API trial are verified.
OPENAI_API_KEY=
AI_PROFILE_PRICING_JSON=

# Manual-only JobSpy source. Keep disabled until access and live pilot are resolved.
JOBSPY_ENABLED=false

# Manual sources, e.g. bayt,glassdoor,zip_recruiter,naukri,bdjobs,hellowork.
# Foreign markets use remote queries; ability to work from Poland is assessed separately.
# No periodic imports.
JOBSPY_SOURCES=
JOBSPY_LINKEDIN_ACCESS_CONFIRMED=false

# Manual-only native Polish connectors; empty/none disables all.
POLISH_SOURCES=bulldogjob,theprotocol,justjoinit,nofluffjobs

# Oceny ofert: osobna jawna konfiguracja ze STAWKAMI BATCH, nie cenami CV.
# Ten sam format pól co AI_PROFILE_PRICING_JSON; brak wartości wyłącza zlecanie ocen.
AI_MATCHING_PRICING_JSON=

# Research podstawowy: osobne ceny STANDARD (nie Batch), gpt-6-luna.
# Wspólny budżet AI. Adapter dodaje koszt do trzech wyszukiwań po 0.01 USD.
# Przykład: {"model":"gpt-6-luna","version":"openai-2026-11-04-standard","inputUsdPerMillion":"0.10","outputUsdPerMillion":"0.50","usdPln":"5","fxVersion":"ceiling-5","maxInputTokens":500000,"maxOutputTokens":6000}
AI_RESEARCH_PRICING_JSON=
