# Generate .env with: node scripts/setup-env.mjs
POSTGRES_PASSWORD=replace-with-a-local-random-secret
WEB_PORT=3100

# Daily SOLID.Jobs import, Europe/Warsaw
SOURCE_SYNC_TIME=08:00


# Optional, server-only. Leave blank until a controlled API trial is verified.
# The model, reasoning effort and prices of profile, matching and research
# are fixed in the AI module (modules/ai/assignments/assignment-settings.ts,
# modules/ai/model-catalog.ts).
OPENAI_API_KEY=

# Manual-only JobSpy source. Keep disabled until access and live pilot are resolved.
JOBSPY_ENABLED=false

# Manual sources, e.g. bayt,glassdoor,zip_recruiter,naukri,bdjobs,hellowork.
# Foreign markets use remote queries; ability to work from Poland is assessed separately.
# No periodic imports.
JOBSPY_SOURCES=
JOBSPY_LINKEDIN_ACCESS_CONFIRMED=false

# Manual-only native Polish connectors; empty/none disables all.
POLISH_SOURCES=bulldogjob,theprotocol,justjoinit,nofluffjobs

# Lokalny model profilu (Ollama): wybór dostawcy jest w ustawieniach modułu AI.
# Kontenery Docker Desktop łączą się z Ollamą na hoście przez host.docker.internal.
# AI_ENDPOINTS_JSON=[{"ref":"ollama","version":1,"url":"http://host.docker.internal:11434","credentialEnv":null}]
